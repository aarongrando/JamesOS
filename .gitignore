# Private working records and generated output
/archive/
/build/
build/
*.log
.env
.env.*

# Firmware packages made by builds; the published ones in releases/ stay tracked
*.fwsc
!/releases/*.fwsc

# Flash dumps, device captures and recordings (private: calibration, keys, user data)
*.bin
*.wav
*.aif
*.aiff

# Python caches
__pycache__/
*.py[cod]

# macOS
.DS_Store
._*

# Public documentation is limited to the current release and component notices.
*.md
*.rst
!/README.md
/docs/*
!/docs/BUILD.md
!/docs/RELEASE-1.0b.md
!/docs/legal/
!/docs/legal/**
!/docs/images/
!/docs/images/**
/.agents/
/.codex/
/.claude/
/work/
/output/
/reports/
/notes/
